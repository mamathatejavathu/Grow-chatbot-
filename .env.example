# ── LLM configuration ─────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in your key.

# Provider: groq | anthropic | openai | gemini | mistral | none
LLM_PROVIDER="groq"

# Model id for the chosen provider.
LLM_MODEL="qwen/qwen3.8-27b"

# Put the matching key in `.env` only. Never commit real keys.
GROQ_API_KEY=""
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
GEMINI_API_KEY=""
MISTRAL_API_KEY=""

LOG_LEVEL="INFO"
