# ── LLM configuration ─────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in your key.

# Provider: "groq" for live answers, "none" for keyless extractive mode.
LLM_PROVIDER=groq

# Groq model id. Must match a model your key can access.
LLM_MODEL=qwen/qwen3.8-27b

# Paste your Groq API key below (it starts with "gsk_").
# Create one at: https://console.groq.com/keys
# Leave empty to fall back to extractive mode automatically.
GROQ_API_KEY=
